{
  "name": "cineloom-community-movie-tracker",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx server.jsx",
    "dev:web": "vite --config vite.config.jsx",
    "build": "vite build --config vite.config.jsx",
    "preview": "vite preview --config vite.config.jsx"
  },
  "dependencies": {
    "dotenv": "^16.5.0",
    "express": "^5.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.4.1",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.3",
    "vite": "^6.3.5"
  }
}
